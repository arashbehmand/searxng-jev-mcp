# Example settings. Never commit real values.
#
# The server does NOT read .env files from the current directory. Put your settings in one of:
#   ~/.config/searxng-jev-mcp/env                 (read automatically)
#   any file you name with --env-file PATH        (repeatable; e.g. in `claude mcp add ... -- ... --env-file /abs/path/.env.local`)
#   any file(s) in SEARXNG_JEV_ENV_FILE           (one path, or several separated by ':' on macOS/Linux)
# Process environment variables (e.g. `claude mcp add -e KEY=value`) override every file.

SEARXNG_URL=http://localhost:8080
# SEARXNG_USERNAME=            # if your SearXNG sits behind basic auth
# SEARXNG_PASSWORD=
# SEARXNG_MAX_CONCURRENCY=4    # concurrent requests to SearXNG (a search makes 1-2)
# ENGINE_OVERRIDES=            # e.g. "yep=off,duckduckgo=on" (forces health decisions)
# ENABLE_GOOGLE_CSE=true       # auto-disabled on 2027-01-01

DECISION_PROVIDER=auto         # auto | openrouter | typesafe | ollaya | custom | none
                               # auto = every available provider, with runtime failover, in the order
                               # OpenRouter -> Ollaya (if running) -> TypeSafe. With any API key set, auto sends
                               # the scrubbed query and public snippets to that hosted provider (docs/privacy.md).
# DECISION_FALLBACK=typesafe   # with an explicit provider: fallbacks tried at runtime, in order
# DECISION_MODEL=typesafe/jev-1.13
# DECISION_ROUTING=0           # 1 lets the decision model choose vertical engines (off: no measured gain)
# AUTHORITY_GUARD=pin3_p80     # off | pin3 | pin3_p80 | pin3_band | pin1_p80 | pin1_band | band_reorder
                               # keeps results SearXNG's engines agree on near the top (docs/evaluation.md)
# OPENROUTER_API_KEY=          # or OS keychain: service "searxng-jev-mcp", account "openrouter"
# TYPESAFE_API_KEY=            # TypeSafe direct (used by DECISION_PROVIDER=typesafe, auto, or DECISION_FALLBACK)
#                              #   alias: TYPESAFE_AI_API_KEY; keychain account "typesafe"
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# OLLAYA_BASE_URL=http://127.0.0.1:11435
# OLLAYA_MODEL=winnow:e4b
# DECISION_BASE_URL=           # only for DECISION_PROVIDER=custom (any /v1/systemone server; https unless localhost)
# DECISION_API_KEY=            # key for the custom server, if it needs one

# DEBUG_TOOLS=0                # 1 exposes route/engines/jev_status tools
# SEARXNG_JEV_DATA_DIR=        # default ~/.cache/searxng-jev-mcp (cache, health, trace log, spend log)
# SEARXNG_JEV_TRACE=1          # 0 disables the local JSONL trace log
# SEARXNG_JEV_CACHE=1
# SEARXNG_JEV_KEYRING=1        # 0 disables OS keychain lookups
